# Скопируйте этот файл в .env и укажите свои данные.
# .env НЕ попадает в git — пароль не будет виден в репозитории.
PORT=3000
NODE_ENV=production

# Доступ в админку (/admin)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Необязательно: секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=

# Необязательно: максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=1024

# Необязательно: где хранить данные и файлы (удобно для Docker/хостинга с диском)
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads
